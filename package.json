{
    "name": "lights-on-14th-listen-sync",
    "version": "0.1.0",
    "description": "Synced show audio for Lights On 14th: Cloudflare relay Worker and browser player.",
    "author": "David Baumwald",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build-client.mjs",
        "dev": "yarn build && wrangler dev",
        "deploy": "yarn build && wrangler deploy",
        "types": "wrangler types",
        "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
        "lint": "eslint .",
        "test": "vitest run",
        "simulate": "node scripts/simulate-fpp.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "typescript": "^6",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3",
        "wrangler": "^4.147.0",
        "ws": "^8.22.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/LightsOn14th/cf-listen-sync.git"
    }
}
