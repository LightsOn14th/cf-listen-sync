{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",
        "lib": [ "es2023" ],
        "types": [ "./worker-configuration.d.ts" ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": [ "src/worker/**/*.ts", "src/shared/**/*.ts", "worker-configuration.d.ts" ]
}
